# Database (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/earmark"

# App URL
NEXT_PUBLIC_URL="http://localhost:3000"

# Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-here"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Earmark <noreply@earmark.co.za>"

# Paystack (South Africa payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Courier (The Courier Guy or similar)
COURIER_API_KEY="your-courier-key"
COURIER_API_URL="https://api.thecourierguy.co.za"

# Analytics
ANALYTICS_ENABLED="true"
